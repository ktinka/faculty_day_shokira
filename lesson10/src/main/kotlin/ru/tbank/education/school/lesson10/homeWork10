fun taskNo6() {
    val datePairs = listOf(
        Pair("2026-01-01", "2026-01-10"),
        Pair("2025-12-31", "2026-01-01"),
        Pair("2026-02-01", "2026-01-22")
    )

    val differences = datePairs.map { (first, second) ->
        val d1 = LocalDate.parse(first)
        val d2 = LocalDate.parse(second)
        ChronoUnit.DAYS.between(d1, d2).toInt()
    }
    println("Difference in days: $differences")
}

